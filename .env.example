# Copie para .env.local. Todas as variáveis são opcionais.

# URL canônica do site (metadata, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://lmsdevop.vercel.app

# Token do GitHub sem escopos: sobe o rate limit de 60 para 5.000 req/h.
GITHUB_TOKEN=

# Envio do formulário de contato via Resend (https://resend.com).
# Sem as duas, o formulário cai para um link mailto: preenchido.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
